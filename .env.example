# Supabase 项目地址（必需）。在 Supabase Dashboard → Project Settings → API 中获取；可暴露给浏览器。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 匿名访问密钥（必需）。在同一 API 页面获取；可暴露给浏览器，但必须配合 RLS 使用。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 服务端高权限密钥（必需）。仅供服务端使用，会绕过 RLS；严禁提交或添加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=

# 应用对外访问地址。开发环境使用下方默认值；生产环境改为完整 HTTPS 域名且末尾不加斜杠。
APP_URL=http://localhost:4001

# 后台维护接口密钥（生产环境建议配置）。可用 `openssl rand -hex 32` 生成；仅供服务端和定时任务使用。
CRON_SECRET=

# 阿里云 DashScope API Key（必需）。用于 qwen3.6-plus 图片识别；属于服务端密钥，禁止公开。
ALIBABA_API_KEY=

# DeepSeek API Key（可选）。配置后启用错因分析和举一反三；不影响基础图片识别功能。
DEEPSEEK_API_KEY=
